# Local data & secrets
# SQLite writes two sidecar files beside the database. Ignoring only *.db
# leaves them untracked and noisy in every `git status` after running the
# server locally.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
.env
.env.*
!.env.example
*.pem
*.key

# Editors & OS
.vscode/
.idea/
.DS_Store

# Generated TypeScript client is committed; node_modules from npx is not.
web/node_modules/
