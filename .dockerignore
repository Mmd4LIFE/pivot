# Everything the build does not need, which is most of it. A smaller context is
# a faster upload to the daemon and, more importantly, keeps a stray local
# database or .env out of an image by accident.

.git
.github
bin/
dist/
coverage.*
*.db
*.db-wal
*.db-shm
*.sqlite*
.env
.env.*
!.env.example

# The frontend build runs inside the image and starts from source.
web/node_modules/
web/dist/
web/storybook-static/
web/.playwright/
web/playwright-report/

# Development-only.
deploy/docker-compose.dev.yml
docs/
*.md
!README.md
