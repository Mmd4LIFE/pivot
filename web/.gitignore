node_modules/
*.tsbuildinfo

# Build output is not committed, but the directory must exist: web/embed.go
# embeds it, and //go:embed fails on a missing directory. The placeholder is
# what lets `go build ./...` work on a fresh clone with no Node installed.
dist/
!dist/.gitkeep

# Storybook's static build. A review artifact, never shipped and never embedded
# -- web/embed.go embeds dist/ only.
storybook-static/

# Playwright's throwaway database, traces and reports. The E2E suite provisions
# its own instance on every run; nothing here is worth keeping.
.playwright/
playwright-report/
