# Pivot — configuration for deploy/docker-compose.yml
#
#   cp .env.example .env
#
# Then fill in the three values that have no default. The stack refuses to
# start without them rather than inventing any, because each one is either a
# secret or the thing that protects your secrets, and a default would be the
# same on every Pivot anybody ever ran.

# ── Required ─────────────────────────────────────────────────────────────────

# The database password. Anything long and random.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# The key that encrypts stored secrets — today an OIDC client secret, and from
# Phase 1 your warehouse credentials.
#   docker run --rm ghcr.io/mmd4life/pivot:0.0.1-alpha secrets generate-key
#
# Keep a copy somewhere your database backups are not. Without it those secrets
# cannot be read, and there is no recovery: that is what it means for the
# encryption to work. See docs/operations/secrets.md.
PIVOT_SECRETS_KEY=

# The token that claims this instance on its first run. Whoever reaches an
# unclaimed Pivot with this token becomes its administrator, so treat it like a
# password and change it after setup is done.
#   openssl rand -base64 24
PIVOT_SETUP_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────

# The release to run. Pinned deliberately: a tag that moves means a restart
# during an incident can also be an upgrade.
PIVOT_VERSION=0.0.1-alpha

# The port on the host.
PIVOT_PORT=8080

# The URL people reach Pivot at. It is what OIDC redirect URIs are built from,
# so it has to be the address a browser actually uses — not the container's.
PIVOT_BASE_URL=http://localhost:8080

# Marks the session cookie Secure. Set this to true once TLS terminates in
# front of Pivot, and not before: a browser refuses to send a Secure cookie
# over plain HTTP, so turning it on early makes every login fail with no
# error anybody can see.
PIVOT_COOKIE_SECURE=false

# debug, info, warn, error.
PIVOT_LOG_LEVEL=info

# Prometheus metrics at /metrics. On by default; there is nothing to configure
# and it costs nothing until something scrapes it.
PIVOT_METRICS_ENABLED=true
